notifyIcon.className = "fa-solid fa-bell text-amber-600";

notifyText.textContent = "通知をオン";

}

}


async function requestNotificationPermission() {

if (!("Notification" in window)) {

showToast("お使いのブラウザはデスクトップ通知に対応していません");

return;

}


if (Notification.permission === "granted") {

showToast("通知機能は設定済み（オン）です");

return;

}


if (Notification.permission === "denied") {

showToast("ブラウザ設定で通知が許可されていません");

return;

}


const permission = await Notification.requestPermission();

updateNotificationUI();


if (permission === "granted") {

showToast("通知を【オン】に設定しました！");

checkUpcomingNotifications(true);

}

}


function checkUpcomingNotifications(forceSend = false) {

if (!("Notification" in window) || Notification.permission !== "granted") return;


const today = new Date();

today.setHours(0, 0, 0, 0);


state.events.forEach(ev => {

const evDate = new Date(ev.date + 'T00:00:00');

const diffTime = evDate.getTime() - today.getTime();

const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));


if (diffDays === 7 || diffDays === 0 || forceSend) {

const notifyKey = `notified_${ev.id}_${diffDays}`;

if (!localStorage.getItem(notifyKey) || forceSend) {

const timeText = diffDays === 0 ? "本日開催されます！" : `あと1週間（${ev.date}）で開催予定です！`;

new Notification(`【行事リマインダー】${ev.title}`, {

body: `${timeText}\n${ev.memo || '詳細をご確認ください。'}`

});

localStorage.setItem(notifyKey, 'true');

}

}

});

}


function renderReminders() {

upcomingReminderList.innerHTML = '';

const today = new Date();

today.setHours(0, 0, 0, 0);


const upcomingEvents = state.events.filter(ev => {

const evDate = new Date(ev.date + 'T00:00:00');

const diffTime = evDate.getTime() - today.getTime();

const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

return diffDays >= 0 && diffDays <= 7;

}).sort((a, b) => a.date.localeCompare(b.date));


upcomingCount.textContent = `${upcomingEvents.length}件`;


if (upcomingEvents.length === 0) {

upcomingReminderList.innerHTML = `<p class="text-amber-700/70 italic text-center py-2 text-xs">直近7日以内の行事はありません</p>`;

return;

}


upcomingEvents.forEach(ev => {

const evDate = new Date(ev.date + 'T00:00:00');

const diffDays = Math.ceil((evDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));

const badgeText = diffDays === 0 ? '本日！' : `あと${diffDays}日`;

const badgeColor = diffDays === 0 ? 'bg-rose-500 text-white animate-pulse' : 'bg-amber-200 text-amber-900 font-bold';


const div = document.createElement('div');

div.className = "bg-white/90 p-2 sm:p-2.5 rounded-xl border border-amber-200 flex items-center justify-between shadow-2xs";

div.innerHTML = `

<div class="truncate pr-2">

