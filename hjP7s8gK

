</div>


<h4 class="font-bold text-slate-800 text-xs sm:text-sm ${state.isAdmin ? 'group-hover:text-indigo-600' : ''}">${escapeHtml(ev.title)}</h4>

${ev.memo ? `<p class="text-[11px] text-slate-600 line-clamp-2 bg-slate-50 p-2 rounded-lg border border-slate-100">${escapeHtml(ev.memo)}</p>` : ''}

