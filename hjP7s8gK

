} else if (Notification.permission === "denied") {

notifyToggleBtn.className = "bg-slate-200 text-slate-500 border border-slate-300 px-2.5 py-1.5 rounded-xl font-semibold text-xs flex items-center space-x-1 cursor-not-allowed";

