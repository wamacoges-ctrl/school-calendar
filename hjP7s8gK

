function openModal(eventToEdit = null) {

if (!state.isAdmin) return;


eventForm.reset();


if (eventToEdit) {

modalTitle.textContent = '行事を編集';

inputId.value = eventToEdit.id;

inputTitle.value = eventToEdit.title;

inputDate.value = eventToEdit.date;

inputTime.value = eventToEdit.time || '';

inputCategory.value = eventToEdit.category;

inputMemo.value = eventToEdit.memo || '';

deleteEventBtn.classList.remove('hidden');

} else {

modalTitle.textContent = '新規行事を追加';

inputId.value = '';

inputDate.value = state.selectedDate || getTodayString();

deleteEventBtn.classList.add('hidden');

}


eventModal.classList.remove('hidden');

}


function closeModal() {

eventModal.classList.add('hidden');

}


async function handleFormSubmit(e) {

e.preventDefault();

if (!state.isAdmin) return;


const id = inputId.value;

const newEventData = {

title: inputTitle.value.trim(),

date: inputDate.value,

time: inputTime.value || '',

category: inputCategory.value,

memo: inputMemo.value.trim()

};


try {

if (db && user) {

if (id) {

const eventRef = doc(db, 'artifacts', appId, 'public', 'data', 'events', id);

await updateDoc(eventRef, newEventData);

showToast('行事を更新しました');

} else {

const eventsCollection = collection(db, 'artifacts', appId, 'public', 'data', 'events');

await addDoc(eventsCollection, newEventData);

showToast('新しい行事を登録しました');

}

} else {

if (id) {

const idx = state.events.findIndex(e => e.id === id);

if (idx !== -1) state.events[idx] = { id, ...newEventData };

} else {

state.events.push({ id: Date.now().toString(), ...newEventData });

}

renderAll();

}

closeModal();

checkUpcomingNotifications(true);

} catch (err) {

console.error("Save Error:", err);

showToast("保存に失敗しました");

}

}


async function executeDeleteEvent() {

if (!state.isAdmin) return;


const id = inputId.value;

if (!id) return;


try {

if (db && user) {

const eventRef = doc(db, 'artifacts', appId, 'public', 'data', 'events', id);

await deleteDoc(eventRef);

} else {

state.events = state.events.filter(e => e.id !== id);

renderAll();

}

deleteConfirmModal.classList.add('hidden');

closeModal();

showToast('行事を削除しました');

} catch (err) {

console.error("Delete Error:", err);

deleteConfirmModal.classList.add('hidden');

showToast("削除に失敗しました");

}

}


function showToast(message) {

const toast = document.getElementById('toast');

const toastMsg = document.getElementById('toast-message');

toastMsg.textContent = message;


toast.classList.remove('translate-y-20', 'opacity-0');

toast.classList.add('translate-y-0', 'opacity-100');


setTimeout(() => {

toast.classList.remove('translate-y-0', 'opacity-100');

toast.classList.add('translate-y-20', 'opacity-0');

}, 3000);

}


function getTodayString() {

const today = new Date();

const y = today.getFullYear();

const m = String(today.getMonth() + 1).padStart(2, '0');

const d = String(today.getDate()).padStart(2, '0');

return `${y}-${m}-${d}`;

}


function escapeHtml(str) {

if (!str) return '';

return str

.replace(/&/g, "&amp;")

.replace(/</g, "&lt;")

.replace(/>/g, "&gt;")

.replace(/"/g, "&quot;")

.replace(/'/g, "&#039;");

}


window.addEventListener('DOMContentLoaded', init);

</script>

