function renderCalendar() {

const year = state.currentDate.getFullYear();

const month = state.currentDate.getMonth();


currentMonthDisplay.textContent = `${year}年 ${month + 1}月`;

calendarGrid.innerHTML = '';


const firstDayIndex = new Date(year, month, 1).getDay();

const lastDay = new Date(year, month + 1, 0).getDate();

const prevLastDay = new Date(year, month, 0).getDate();

const todayStr = getTodayString();


for (let i = firstDayIndex; i > 0; i--) {

const dayNum = prevLastDay - i + 1;

const cell = createCell(dayNum, true);

calendarGrid.appendChild(cell);

}


for (let day = 1; day <= lastDay; day++) {

const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;

const isToday = dateStr === todayStr;

const isSelected = dateStr === state.selectedDate;


const dayEvents = state.events.filter(e => {

const matchCategory = state.filterCategory === 'all' || e.category === state.filterCategory;

return e.date === dateStr && matchCategory;

});


const cell = createCell(day, false, isToday, isSelected, dateStr, dayEvents);

calendarGrid.appendChild(cell);

}


const totalCellsSoFar = firstDayIndex + lastDay;

const remainingCells = (7 - (totalCellsSoFar % 7)) % 7;

for (let i = 1; i <= remainingCells; i++) {

const cell = createCell(i, true);

calendarGrid.appendChild(cell);

}

}


function createCell(dayNumber, isOtherMonth, isToday = false, isSelected = false, dateStr = null, events = []) {

const cell = document.createElement('div');

cell.className = `min-h-[58px] sm:min-h-[90px] border border-slate-100 rounded-xl p-1 sm:p-1.5 flex flex-col justify-between transition-all ${

isOtherMonth ? 'bg-slate-50/50 text-slate-300 opacity-40 pointer-events-none' : 'bg-white hover:border-indigo-300 cursor-pointer active:bg-indigo-50/30'

}`;


if (isSelected) {

cell.classList.add('ring-2', 'ring-indigo-500', 'bg-indigo-50/30');

}


if (!isOtherMonth) {

cell.addEventListener('click', () => {

state.selectedDate = dateStr;

renderAll();

});

}


const header = document.createElement('div');

header.className = 'flex items-center justify-between';


const dayNumSpan = document.createElement('span');

dayNumSpan.className = `text-xs sm:text-sm font-semibold inline-flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6 rounded-full ${

isToday ? 'bg-indigo-600 text-white shadow-2xs font-bold' : 'text-slate-700'

}`;

dayNumSpan.textContent = dayNumber;


header.appendChild(dayNumSpan);


const eventContainer = document.createElement('div');

eventContainer.className = 'space-y-0.5 sm:space-y-1 mt-0.5 overflow-hidden flex-1';


const maxVisible = 2;

events.slice(0, maxVisible).forEach(ev => {

const cat = CATEGORIES[ev.category] || CATEGORIES.school;

const badge = document.createElement('div');

badge.className = `text-[9px] sm:text-xs px-1 py-0.5 rounded-md truncate font-medium ${cat.bg} ${cat.text} flex items-center space-x-1`;

badge.title = `${ev.time ? ev.time + ' ' : ''}${ev.title}`;

badge.innerHTML = `<span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full ${cat.dot} flex-shrink-0"></span><span class="truncate hidden sm:inline">${escapeHtml(ev.title)}</span>`;

eventContainer.appendChild(badge);

});


if (events.length > maxVisible) {

const more = document.createElement('div');

more.className = 'text-[8px] sm:text-[9px] text-slate-400 font-bold px-0.5';

more.textContent = `+${events.length - maxVisible}`;

eventContainer.appendChild(more);

}


cell.appendChild(header);

cell.appendChild(eventContainer);


return cell;

}


