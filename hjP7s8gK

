function getFormattedDate(monthOffset = 0, dayOffset = 0) {

const now = new Date();

const target = new Date(now.getFullYear(), now.getMonth() + monthOffset, now.getDate() + dayOffset);

const y = target.getFullYear();

const m = String(target.getMonth() + 1).padStart(2, '0');

const d = String(target.getDate()).padStart(2, '0');

return `${y}-${m}-${d}`;

}


